{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run SATS-402 dashboard",
      "program": "${workspaceFolder}/src/server.js",
      "env": {
        "PORT": "4020",
        "SATS402_DEMO_MODE": "hybrid",
        "SATS402_LIGHTNING_BACKEND": "sim"
      },
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Mutinynet doctor",
      "program": "${workspaceFolder}/scripts/mutinynet-doctor.js",
      "envFile": "${workspaceFolder}/.env.mutinynet",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Mutinynet live atomic bridge",
      "program": "${workspaceFolder}/scripts/mutinynet-live-demo.js",
      "envFile": "${workspaceFolder}/.env.mutinynet",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run CLI controlled demo",
      "program": "${workspaceFolder}/scripts/demo-cli.js",
      "console": "integratedTerminal"
    }
  ]
}
